{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "infrastructure",
    "application",
    "observability",
    "conditions",
    "execution",
    "provenance"
  ],
  "$defs": {
    "tier": {
      "enum": [
        "edge",
        "fog",
        "cloud",
        "hpc"
      ]
    },
    "ms_list": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      ]
    }
  },
  "properties": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "hypothesis",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        },
        "federated": {
          "type": "boolean",
          "description": "if true, at least 2 distinct domains are required"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sites",
        "links"
      ],
      "properties": {
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tier",
              "site",
              "domain",
              "nodes"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "tier": {
                "$ref": "#/$defs/tier"
              },
              "site": {
                "type": "string",
                "description": "SLICES site id, or 'local' for non-federated nodes"
              },
              "provider": {
                "enum": [
                  "slices-cli",
                  "manual"
                ],
                "default": "slices-cli"
              },
              "nodes": {
                "type": "integer",
                "minimum": 1
              },
              "arch": {
                "enum": [
                  "arm64",
                  "amd64"
                ]
              },
              "device": {
                "type": "string"
              },
              "flavor": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "cpu": {
                "type": "integer"
              },
              "mem": {
                "type": "string"
              },
              "access": {
                "enum": [
                  "wired",
                  "wireless"
                ]
              },
              "optional": {
                "type": "boolean"
              },
              "emulated": {
                "type": "boolean",
                "description": "emulated node (container with resource limits) instead of real hardware"
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cpus": {
                    "type": "number"
                  },
                  "mem": {
                    "type": "string"
                  }
                }
              },
              "domain": {
                "type": "string",
                "description": "administrative domain (e.g. slices-gent, unime-messina)"
              },
              "host": {
                "type": "string",
                "description": "manual provider only: SSH alias of the remote node; if absent, the node is the local machine"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "profile"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "profile": {
                "enum": [
                  "lan",
                  "wan"
                ]
              }
            }
          }
        },
        "impairments": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "delay_ms": {
                "$ref": "#/$defs/ms_list"
              },
              "jitter_ms": {
                "type": "number",
                "minimum": 0
              },
              "loss_pct": {
                "$ref": "#/$defs/ms_list"
              }
            }
          },
          "description": "keyed by link profile (lan|wan)"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "components",
        "dataflows",
        "timing",
        "workload_profile"
      ],
      "properties": {
        "class": {
          "enum": [
            "control-cps",
            "monitoring-cps",
            "digital-twin"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "placement"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "placement": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/tier"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "$ref": "#/$defs/tier"
                    }
                  }
                ]
              }
            }
          }
        },
        "dataflows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "rate_hz"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "rate_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control_period_s",
            "deadline_ms"
          ],
          "properties": {
            "control_period_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "deadline_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "workload_profile": {
          "type": "string"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_sync",
        "metrics",
        "sampling_s"
      ],
      "properties": {
        "level": {
          "description": "minimal: application metrics from the gateway only; full: in addition an agent on every node (CPU, memory, network, RTT probes). If it is a list it becomes a factor of the sweep.",
          "oneOf": [
            {"enum": ["minimal", "full"]},
            {"type": "array", "minItems": 1, "items": {"enum": ["minimal", "full"]}}
          ]
        },
        "clock_sync": {
          "enum": [
            "none",
            "ntp",
            "chrony",
            "ptp"
          ]
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "traces": {
          "enum": [
            "none",
            "opentelemetry"
          ]
        },
        "sampling_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded"
      ],
      "properties": {
        "recorded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitions",
        "duration_min",
        "warmup_min"
      ],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "duration_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warmup_min": {
          "type": "number",
          "minimum": 0
        },
        "termination": {
          "type": "object"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "format"
      ],
      "properties": {
        "capture": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "format": {
          "enum": [
            "ro-crate",
            "json"
          ]
        }
      }
    }
  }
}
